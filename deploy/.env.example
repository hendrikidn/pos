# Salin menjadi deploy/.env lalu isi. File .env tidak masuk repositori.

# Domain POS (DNS A record ke IP VPS). Dipakai untuk tautan di notifikasi; HTTPS diurus web server yang sudah ada di VPS.
DOMAIN=anatta-pos.dolanyu.com

# Port lokal (127.0.0.1) tempat web server di VPS meneruskan permintaan. Ubah hanya bila bentrok (cek: sudo ss -tlnp).
API_PORT=18081
DASHBOARD_PORT=18082
ADMIN_PORT=18083

# Sandi database. Buat dengan: openssl rand -hex 24   (hex agar aman di alamat koneksi)
POSTGRES_PASSWORD=

# Opsional: asal yang boleh memanggil API dari browser (aplikasi POS berbasis web), pisahkan dengan koma.
# Dashboard dan sensor tidak membutuhkannya.
CORS_ORIGINS=

# Email kode masuk owner (SMTP). Contoh untuk Brevo (https://www.brevo.com):
#   SMTP_HOST   smtp-relay.brevo.com   SMTP_PORT 587 (STARTTLS)   [465 + SMTP_SECURE=true untuk TLS langsung]
#   SMTP_USER   "SMTP login" dari Brevo (menu SMTP & API, tab SMTP; bentuknya xxxxxx@smtp-brevo.com), BUKAN email akun Anda
#   SMTP_PASS   "SMTP key" yang dibuat di halaman yang sama, BUKAN sandi akun Brevo
#   MAIL_FROM   pengirim yang sudah diverifikasi di Brevo, mis. Anatta POS <no-reply@dolanyu.com>
# Tanpa SMTP_HOST, kode tidak terkirim dan owner hanya bisa masuk dengan token.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Anatta POS <no-reply@dolanyu.com>

# Opsional: notifikasi WhatsApp insiden kritis. Kosong = hanya dicatat di log.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=

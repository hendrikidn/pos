# Salin menjadi deploy/.env lalu isi. File .env tidak masuk repositori.

# Domain POS (DNS A record ke IP VPS). Dipakai untuk tautan di notifikasi; HTTPS diurus web server yang sudah ada di VPS.
DOMAIN=pos.dolanyu.com

# Port lokal (127.0.0.1) tempat web server di VPS meneruskan permintaan. Ubah hanya bila bentrok (cek: sudo ss -tlnp).
API_PORT=18081
DASHBOARD_PORT=18082

# Sandi database. Buat dengan: openssl rand -hex 24   (hex agar aman di alamat koneksi)
POSTGRES_PASSWORD=

# Opsional: asal yang boleh memanggil API dari browser (aplikasi POS berbasis web), pisahkan dengan koma.
# Dashboard dan sensor tidak membutuhkannya.
CORS_ORIGINS=

# Opsional: notifikasi WhatsApp insiden kritis. Kosong = hanya dicatat di log.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=
